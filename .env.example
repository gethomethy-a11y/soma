# ─────────────────────────────────────────────────────────────────────────────
# SOMA environment variables
#
# Copy this file to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.
#
# Anything prefixed VITE_ is bundled into the browser and is PUBLIC.
# Everything else stays server-side and must never be given the VITE_ prefix.
# ─────────────────────────────────────────────────────────────────────────────

# ── Public (safe in the browser) ─────────────────────────────────────────────
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Server-side only (NEVER prefix these with VITE_) ─────────────────────────
# Anthropic Console → API keys. Powers /api/coach.
ANTHROPIC_API_KEY=sk-ant-...

# Stripe → Developers → API keys (use the secret key, not the publishable one)
STRIPE_SECRET_KEY=sk_live_or_test_...

# Stripe → the recurring $12/month price you created (starts with price_)
STRIPE_PRICE_ID=price_...

# Stripe → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Supabase → Project Settings → API → service_role key.
# Used only by the Stripe webhook to flip `premium`. Bypasses RLS — keep secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
